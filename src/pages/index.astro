---
import { ComingSoon } from "../components/ComingSoon";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-16">
		<p class="text-xs font-medium uppercase tracking-[0.2em] text-emerald-400">CS legends draft</p>
		<h1 class="mt-3 text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">
			Major Winners
		</h1>
		<p class="mt-4 text-lg text-zinc-300">
			Roll an org-year. Pick a player. Build a five-man. Go 9-0.
		</p>
		<ComingSoon client:load />
	</main>
</Layout>
